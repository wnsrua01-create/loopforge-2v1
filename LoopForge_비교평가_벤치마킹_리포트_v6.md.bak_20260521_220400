## 5. 파워셀(PowerShell)에서 바로 고칠 수 있는 것

```powershell
# 작업 폴더 이동
cd "D:\1인기업\LoopForge AI"

# 1. Turnstile sitekey 교체 (YOUR_ACTUAL_SITEKEY에 실제 키 입력)
(Get-Content index.html -Encoding UTF8) -replace '0x4AAAAAAA\.\.\.YOUR_SITEKEY\.\.\.', 'YOUR_ACTUAL_SITEKEY' | Set-Content index.html -Encoding UTF8

# 2. http → https 카카오 링크 교체
(Get-Content index.html -Encoding UTF8) -replace 'http://pf\.kakao\.com', 'https://pf.kakao.com' | Set-Content index.html -Encoding UTF8

# 3. Worker URL 확인 (실제 배포된 Worker URL 교체)
(Get-Content index.html -Encoding UTF8) -replace 'loopforge-contact-proxy\.wnsrua01\.workers\.dev', 'YOUR_WORKER_URL.workers.dev' | Set-Content index.html -Encoding UTF8

# 4. 검색해서 placeholder 잔존 여부 확인
Select-String -Path index.html -Pattern "YOUR_|placeholder|example\.com|localhost" -Encoding UTF8

# 5. 파일 인코딩 UTF-8 BOM없이 저장 (BOM 있으면 브라우저 깨짐)
$content = [System.IO.File]::ReadAllText("index.html", [System.Text.Encoding]::UTF8)
[System.IO.File]::WriteAllText("index.html", $content, (New-Object System.Text.UTF8Encoding $False))

# 6. Cloudflare _headers 파일 생성 (CSP는 여기서만)
$headers = @"
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.workers.dev;
"@
$headers | Out-File -FilePath "_headers" -Encoding UTF8NoBOM

Write-Host "✅ 완료! index.html 수정 및 _headers 생성됨" -ForegroundColor Green
```

